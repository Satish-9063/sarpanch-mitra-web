# Sarpanch Mitra Web — environment variables
# Copy to .env.local for local development. Never commit real secrets.
# All server-side secrets are managed via GCP Secret Manager only.
#
# NOTE: Vite exposes only VITE_* vars to the browser bundle. Server-only vars
# (ESP_API_KEY, CMS_API_TOKEN) must stay on the Cloud Run API service.

# Base URL for the Cloud Run API service (forms: contact, newsletter, feedback).
# Leave blank in local dev — form submissions will fail until Cloud Run is deployed.
VITE_API_BASE_URL=

# GCP project identifier (browser-safe — not a secret).
VITE_GCP_PROJECT_ID=arcane-atom-493012-p1

# Privacy-first analytics ID — pending OI-W05 vendor decision.
VITE_ANALYTICS_ID=

# --- SERVER-SIDE ONLY (Cloud Run service, never in this SPA bundle) ---
# CMS_API_URL=
# CMS_API_TOKEN=
# ESP_API_KEY=
